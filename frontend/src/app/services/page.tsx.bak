"use client";

import Link from "next/link";
import { Suspense, useEffect, useMemo, useState } from "react";
import { useSearchParams } from "next/navigation";
import { discoveryApi } from "@/api/discovery_api";
import type { DiscoveryService } from "@/api/discovery_api";
import type { Category } from "@/types/category";
import { apiClient } from "@/utils/api_client";

interface ProviderRating {
  provider_id: string;
  average_rating: number;
  total_reviews: number;
}

type SortOption = "relevance" | "price_low" | "price_high" | "rating" | "reviews";

function formatPrice(value: string | number): string {
  const amount = Number(value);

  if (!Number.isFinite(amount)) return `PKR ${value}`;

  return `PKR ${amount.toLocaleString("en-PK", {
    maximumFractionDigits: 2,
  })}`;
}

function getServiceLocation(service: DiscoveryService): string {
  return (
    service.location ||
    service.provider?.city ||
    service.provider?.location ||
    "Location not provided"
  );
}

function ServicesPageContent() {
  const searchParams = useSearchParams();

  // Read URL filters directly instead of setting state inside an effect.
  // Support both the current "search" parameter and the legacy "q" parameter.
  const initialSearch =
    searchParams.get("search") ?? searchParams.get("q") ?? "";
  const initialCategoryId = searchParams.get("category_id") ?? "";

  const [services, setServices] = useState<DiscoveryService[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [ratings, setRatings] = useState<Record<string, ProviderRating>>({});
  const [search, setSearch] = useState(initialSearch);
  const [categoryId, setCategoryId] = useState(initialCategoryId);
  const [location, setLocation] = useState("");
  const [minPrice, setMinPrice] = useState("");
  const [maxPrice, setMaxPrice] = useState("");
  const [minRating, setMinRating] = useState("");
  const [sort, setSort] = useState<SortOption>("relevance");
  const [loading, setLoading] = useState(true);
  const [serviceError, setServiceError] = useState(false);
  const [categoryError, setCategoryError] = useState(false);

  useEffect(() => {
    let cancelled = false;

    async function loadDiscoveryData() {
      setLoading(true);
      setServiceError(false);
      setCategoryError(false);

      const [serviceResult, categoryResult] = await Promise.allSettled([
        discoveryApi.listServices(),
        discoveryApi.listCategories(),
      ]);

      if (cancelled) return;

      if (serviceResult.status === "fulfilled") {
        const activeServices = serviceResult.value.items.filter(
          (service) => service.is_active,
        );

        setServices(activeServices);

        // Fetch one rating summary per provider, even if they offer
        // multiple services.
        const providerIds = [
          ...new Set(activeServices.map((service) => service.provider_id)),
        ];

        const ratingResults = await Promise.allSettled(
          providerIds.map((providerId) =>
            apiClient.get<ProviderRating>(
              `/api/providers/${providerId}/rating`,
            ),
          ),
        );

        if (cancelled) return;

        const ratingMap: Record<string, ProviderRating> = {};

        ratingResults.forEach((result, index) => {
          if (result.status === "fulfilled") {
            ratingMap[providerIds[index]] = result.value;
          }
        });

        setRatings(ratingMap);
      } else {
        setServices([]);
        setRatings({});
        setServiceError(true);
      }

      if (categoryResult.status === "fulfilled") {
        setCategories(
          categoryResult.value
            .filter((category) => category.is_active)
            .sort((a, b) => a.display_order - b.display_order),
        );
      } else {
        setCategories([]);
        setCategoryError(true);
      }

      if (!cancelled) setLoading(false);
    }

    void loadDiscoveryData();

    return () => {
      cancelled = true;
    };
  }, []);

  const categoryNames = useMemo(
    () => new Map(categories.map((category) => [category.id, category.name])),
    [categories],
  );

  const filteredServices = useMemo(() => {
    const query = search.trim().toLowerCase();
    const normalizedLocation = location.trim().toLowerCase();

    return services.filter((service) => {
      const provider = service.provider;
      const providerRating = ratings[service.provider_id];
      const categoryName = categoryNames.get(service.category_id) ?? "";

      const searchableText = [
        service.name,
        service.description ?? "",
        provider?.business_name ?? "",
        provider?.city ?? "",
        provider?.location ?? "",
        service.location ?? "",
        categoryName,
      ]
        .join(" ")
        .toLowerCase();

      const matchesSearch = !query || searchableText.includes(query);
      const matchesCategory =
        !categoryId || service.category_id === categoryId;

      const serviceLocation = getServiceLocation(service).toLowerCase();
      const matchesLocation =
        !normalizedLocation || serviceLocation.includes(normalizedLocation);

      const price = Number(service.price);
      const matchesMinPrice =
        minPrice.trim() === "" ||
        (Number.isFinite(price) && price >= Number(minPrice));
      const matchesMaxPrice =
        maxPrice.trim() === "" ||
        (Number.isFinite(price) && price <= Number(maxPrice));

      const rating = Number(providerRating?.average_rating ?? 0);
      const matchesRating =
        minRating === "" ||
        (providerRating !== undefined && rating >= Number(minRating));

      return (
        matchesSearch &&
        matchesCategory &&
        matchesLocation &&
        matchesMinPrice &&
        matchesMaxPrice &&
        matchesRating
      );
    });
  }, [
    services,
    ratings,
    categoryNames,
    search,
    categoryId,
    location,
    minPrice,
    maxPrice,
    minRating,
  ]);

  const sortedServices = useMemo(() => {
    const sorted = [...filteredServices];

    switch (sort) {
      case "price_low":
        return sorted.sort((a, b) => Number(a.price) - Number(b.price));

      case "price_high":
        return sorted.sort((a, b) => Number(b.price) - Number(a.price));

      case "rating":
        return sorted.sort(
          (a, b) =>
            (ratings[b.provider_id]?.average_rating ?? 0) -
            (ratings[a.provider_id]?.average_rating ?? 0),
        );

      case "reviews":
        return sorted.sort(
          (a, b) =>
            (ratings[b.provider_id]?.total_reviews ?? 0) -
            (ratings[a.provider_id]?.total_reviews ?? 0),
        );

      default:
        return sorted;
    }
  }, [filteredServices, ratings, sort]);

  function clearFilters() {
    setSearch("");
    setCategoryId("");
    setLocation("");
    setMinPrice("");
    setMaxPrice("");
    setMinRating("");
    setSort("relevance");

    window.history.replaceState({}, "", "/services");
  }

  return (
    <main className="min-h-screen bg-background">
      <section className="border-b border-line bg-surface">
        <div className="container py-10">
          <p className="text-xs font-bold uppercase tracking-[0.14em] text-brand">
            Discover services
          </p>

          <h1 className="mt-2 text-3xl font-bold sm:text-4xl">
            Find the right service for you
          </h1>

          <p className="mt-3 max-w-2xl text-sm leading-6 text-muted">
            Explore active services, compare prices and provider ratings, and
            find a professional that meets your needs.
          </p>

          <div className="mt-8 rounded-2xl border border-line bg-background p-4 shadow-sm">
            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <div>
                <label
                  htmlFor="service-search"
                  className="mb-2 block text-sm font-semibold"
                >
                  Search services or providers
                </label>
                <input
                  id="service-search"
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                  placeholder="e.g. haircut, cleaning..."
                  className="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm outline-none focus:border-brand"
                />
              </div>

              <div>
                <label
                  htmlFor="category"
                  className="mb-2 block text-sm font-semibold"
                >
                  Category
                </label>
                <select
                  id="category"
                  value={categoryId}
                  onChange={(event) => setCategoryId(event.target.value)}
                  className="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm outline-none focus:border-brand"
                >
                  <option value="">All categories</option>
                  {categories.map((category) => (
                    <option key={category.id} value={category.id}>
                      {category.name}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label
                  htmlFor="location"
                  className="mb-2 block text-sm font-semibold"
                >
                  Location
                </label>
                <input
                  id="location"
                  value={location}
                  onChange={(event) => setLocation(event.target.value)}
                  placeholder="City or area"
                  className="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm outline-none focus:border-brand"
                />
              </div>

              <div>
                <label
                  htmlFor="min-price"
                  className="mb-2 block text-sm font-semibold"
                >
                  Minimum price (PKR)
                </label>
                <input
                  id="min-price"
                  type="number"
                  min="0"
                  value={minPrice}
                  onChange={(event) => setMinPrice(event.target.value)}
                  placeholder="e.g. 1000"
                  className="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm outline-none focus:border-brand"
                />
              </div>

              <div>
                <label
                  htmlFor="max-price"
                  className="mb-2 block text-sm font-semibold"
                >
                  Maximum price (PKR)
                </label>
                <input
                  id="max-price"
                  type="number"
                  min="0"
                  value={maxPrice}
                  onChange={(event) => setMaxPrice(event.target.value)}
                  placeholder="e.g. 5000"
                  className="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm outline-none focus:border-brand"
                />
              </div>

              <div>
                <label
                  htmlFor="rating"
                  className="mb-2 block text-sm font-semibold"
                >
                  Minimum provider rating
                </label>
                <select
                  id="rating"
                  value={minRating}
                  onChange={(event) => setMinRating(event.target.value)}
                  className="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm outline-none focus:border-brand"
                >
                  <option value="">Any rating</option>
                  <option value="4">4.0 and above</option>
                  <option value="4.5">4.5 and above</option>
                  <option value="4.8">4.8 and above</option>
                </select>
              </div>
            </div>

            <div className="mt-4 flex justify-end">
              <button
                type="button"
                onClick={clearFilters}
                className="rounded-xl border border-line px-5 py-2.5 text-sm font-semibold transition hover:bg-surface"
              >
                Clear filters
              </button>
            </div>

            {categoryError && (
              <p className="mt-3 text-sm text-muted" role="status">
                Categories are temporarily unavailable. You can still search
                and browse services.
              </p>
            )}
          </div>
        </div>
      </section>

      <section className="container py-10">
        <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 className="text-xl font-bold">Available services</h2>
            <p className="mt-1 text-sm text-muted" aria-live="polite">
              {loading
                ? "Loading services..."
                : `${sortedServices.length} service${
                    sortedServices.length === 1 ? "" : "s"
                  } found`}
            </p>
          </div>

          <div className="flex items-center gap-3">
            <label htmlFor="sort" className="text-sm font-semibold">
              Sort by
            </label>
            <select
              id="sort"
              value={sort}
              onChange={(event) => setSort(event.target.value as SortOption)}
              className="rounded-xl border border-line bg-surface px-4 py-2.5 text-sm outline-none focus:border-brand"
            >
              <option value="relevance">Default</option>
              <option value="rating">Highest rated</option>
              <option value="reviews">Most reviewed</option>
              <option value="price_low">Price: low to high</option>
              <option value="price_high">Price: high to low</option>
            </select>
          </div>
        </div>

        {loading && (
          <p className="mt-6 text-sm text-muted" role="status">
            Fetching services from the server...
          </p>
        )}

        {!loading && serviceError && (
          <div className="mt-6 rounded-2xl border border-line bg-surface p-8">
            <h3 className="font-bold">Services could not be loaded</h3>
            <p className="mt-2 text-sm leading-6 text-muted">
              The services API is currently unavailable. Please try again
              later. No sample services are being shown as real listings.
            </p>
          </div>
        )}

        {!loading && !serviceError && sortedServices.length === 0 && (
          <div className="mt-6 rounded-2xl border border-dashed border-line bg-surface p-10 text-center">
            <h3 className="text-lg font-bold">No services found</h3>
            <p className="mt-2 text-sm text-muted">
              Try changing your search or filters.
            </p>
            <button
              type="button"
              onClick={clearFilters}
              className="mt-5 rounded-xl bg-brand px-5 py-2.5 text-sm font-semibold text-white"
            >
              Clear filters
            </button>
          </div>
        )}

        {!loading && !serviceError && sortedServices.length > 0 && (
          <div className="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {sortedServices.map((service) => {
              const provider = service.provider;
              const rating = ratings[service.provider_id];
              const categoryName = categoryNames.get(service.category_id);

              return (
                <article
                  key={service.id}
                  className="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
                >
                  <div className="flex h-36 items-center justify-center bg-background">
                    {provider?.profile_image_url ? (
                      // eslint-disable-next-line @next/next/no-img-element
                      <img
                        src={provider.profile_image_url}
                        alt={`${provider.business_name} profile`}
                        className="h-full w-full object-cover"
                      />
                    ) : (
                      <span className="text-4xl font-bold text-brand">
                        {service.name.charAt(0).toUpperCase()}
                      </span>
                    )}
                  </div>

                  <div className="flex flex-1 flex-col p-5">
                    {categoryName && (
                      <p className="text-xs font-bold uppercase tracking-wide text-brand">
                        {categoryName}
                      </p>
                    )}

                    <h3 className="mt-1 text-lg font-bold">{service.name}</h3>

                    <p className="mt-2 line-clamp-2 text-sm leading-5 text-muted">
                      {service.description ||
                        "Contact the provider for details."}
                    </p>

                    <p className="mt-4 text-sm">
                      <span className="text-muted">Provider: </span>
                      {provider ? (
                        <Link
                          href={`/providers/${provider.id}`}
                          className="font-semibold text-brand hover:underline"
                        >
                          {provider.business_name}
                        </Link>
                      ) : (
                        <span className="text-muted">
                          Provider details unavailable
                        </span>
                      )}
                    </p>

                    <p className="mt-2 text-sm text-muted">
                      {getServiceLocation(service)}
                    </p>

                    <div className="mt-3 flex flex-wrap items-center gap-2 text-xs">
                      <span className="rounded-full border border-line px-2.5 py-1">
                        {service.service_type.replaceAll("_", " ")}
                      </span>
                      <span className="rounded-full border border-line px-2.5 py-1">
                        {service.duration_minutes} minutes
                      </span>
                      {rating && (
                        <span className="rounded-full border border-line px-2.5 py-1">
                          ★ {Number(rating.average_rating).toFixed(1)} (
                          {rating.total_reviews}{" "}
                          {rating.total_reviews === 1 ? "review" : "reviews"})
                        </span>
                      )}
                    </div>

                    <div className="mt-auto mt-5 flex items-end justify-between gap-3 border-t border-line pt-4">
                      <div>
                        <span className="text-xs text-muted">Price</span>
                        <p className="text-lg font-bold">
                          {formatPrice(service.price)}
                        </p>
                      </div>

                      <Link
                        href={`/booking?provider_id=${encodeURIComponent(
                          service.provider_id,
                        )}&service_id=${encodeURIComponent(service.id)}`}
                        className="btn-primary inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold"
                      >
                        Book now
                      </Link>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}

        <p className="mt-8 text-xs leading-5 text-muted">
          Ratings are based on available provider review summaries. Weekly
          schedules don&apos;t guarantee that a specific appointment slot is
          free; check the provider&apos;s availability before booking.
        </p>
      </section>
    </main>
  );
}

export default function ServicesPage() {
  return (
    <Suspense
      fallback={
        <main className="min-h-screen bg-background">
          <section className="container py-10">
            <p className="text-sm text-muted" role="status">
              Loading services...
            </p>
          </section>
        </main>
      }
    >
      <ServicesPageContent />
    </Suspense>
  );
}
